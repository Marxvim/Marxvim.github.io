---
import Layout from '../layouts/Layout.astro';
import Lattice from '../components/Lattice.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SystemIcon from '../components/SystemIcon.astro';

const title = 'Marxvim — Systems';
const description = 'Directory for Marxvim systems.';

const systems = [
  {
    label: 'Home',
    host: 'marxvim.com',
    note: 'Public site.',
    href: 'https://marxvim.com',
    icon: 'home',
  },
  {
    label: 'Enterprise Console',
    host: 'enterprise.marxvim.com',
    note: 'Enterprise operator console.',
    href: 'https://enterprise.marxvim.com',
    icon: 'console',
  },
  {
    label: 'n8n',
    host: 'n8n.marxvim.com',
    note: 'Workflow automation and orchestration.',
    href: 'https://n8n.marxvim.com',
    icon: 'n8n',
  },
  {
    label: 'Langfuse',
    host: 'ngrok tunnel',
    note: 'Tracing, evals, and observability.',
    href: 'https://4b51-2601-447-d080-cc80-41d9-8112-26f-595c.ngrok-free.app/',
    icon: 'langfuse',
  },
  {
    label: 'GitHub',
    host: 'github.com/marxvim',
    note: 'Source, issues, and CI.',
    href: 'https://github.com/marxvim',
    icon: 'github',
  },
  {
    label: 'Node Enterprise',
    host: 'app.nodeenterprise.ai',
    note: 'Node Enterprise application.',
    href: 'https://app.nodeenterprise.ai/',
    icon: 'node',
  },
  {
    label: 'Fortify Risk',
    host: 'fortifyriskai-lp-app.vercel.app',
    note: 'Fortify Risk application.',
    href: 'https://fortifyriskai-lp-app.vercel.app/',
    icon: 'fortify',
  },
] as const;

const total = String(systems.length).padStart(2, '0');
---

<Layout title={title} description={description}>
  <Lattice />
  <SiteHeader />

  <main class="console">
    <h1 class="visually-hidden">Marxvim systems</h1>

    <div class="frame">
      <div class="query">
        <span class="query__prompt" aria-hidden="true">systems</span>
        <span class="query__sep" aria-hidden="true">/</span>
        <input
          id="sys-query"
          class="query__input"
          type="text"
          role="combobox"
          aria-expanded="true"
          aria-controls="sys-list"
          aria-autocomplete="list"
          aria-label="Filter systems"
          placeholder="type to filter"
          autocomplete="off"
          spellcheck="false"
        />
        <span class="query__count" data-count>{total}</span>
      </div>

      <div class="body">
        <ul id="sys-list" class="list" role="listbox" aria-label="Systems">
          {
            systems.map((item, i) => (
              <li class="list__item" role="presentation">
                <a
                  class="row"
                  id={`sys-${i}`}
                  role="option"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  href={item.href}
                  rel="noopener"
                  data-index={i}
                  data-search={`${item.label} ${item.host} ${item.note} ${item.href}`.toLowerCase()}
                >
                  <span class="row__n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="row__mark mark" aria-hidden="true">
                    <SystemIcon name={item.icon} />
                  </span>
                  <span class="row__label">{item.label}</span>
                  <span class="row__host">{item.host}</span>
                  <span class="row__go" aria-hidden="true">
                    ↵
                  </span>
                </a>
              </li>
            ))
          }
          <li class="list__empty" role="presentation" hidden>No system matches.</li>
        </ul>

        <aside class="detail" aria-live="polite">
          {
            systems.map((item, i) => (
              <article class="card" data-card={i} hidden={i !== 0}>
                <span class="card__n" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="card__mark mark mark--live" aria-hidden="true">
                  <SystemIcon name={item.icon} />
                </span>
                <h2 class="card__label">{item.label}</h2>
                <p class="card__note">{item.note}</p>
                <span class="card__url">{item.href.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span>
              </article>
            ))
          }
        </aside>
      </div>

      <p class="keys">
        <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
        <span><kbd>↵</kbd> open</span>
        <span><kbd>esc</kbd> clear</span>
      </p>
    </div>
  </main>
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>('.query__input');
  const list = document.querySelector<HTMLElement>('.list');
  const rows = [...document.querySelectorAll<HTMLAnchorElement>('.row')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const empty = document.querySelector<HTMLElement>('.list__empty');
  const count = document.querySelector<HTMLElement>('[data-count]');

  if (input && list && empty && count && rows.length) {
    const pad = (n: number) => String(n).padStart(2, '0');
    let visible = [...rows];
    let active = 0;

    /** Nudges the WebGL lattice so the background answers the selection. */
    const signal = (index: number) => {
      window.dispatchEvent(
        new CustomEvent('marx:select', { detail: { index, total: rows.length } }),
      );
    };

    const select = (next: number, { scroll = true } = {}) => {
      if (!visible.length) return;
      active = Math.max(0, Math.min(next, visible.length - 1));
      const row = visible[active];

      for (const other of rows) other.setAttribute('aria-selected', 'false');
      row.setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', row.id);

      const index = Number(row.dataset.index);
      for (const card of cards) card.hidden = Number(card.dataset.card) !== index;

      if (scroll) row.scrollIntoView({ block: 'nearest' });
      signal(index);
    };

    const filter = () => {
      const query = input.value.trim().toLowerCase();

      for (const row of rows) {
        const match = !query || (row.dataset.search ?? '').includes(query);
        (row.parentElement as HTMLElement).hidden = !match;
      }

      visible = rows.filter((row) => !(row.parentElement as HTMLElement).hidden);
      empty.hidden = visible.length > 0;
      count.textContent = query ? `${pad(visible.length)}/${pad(rows.length)}` : pad(rows.length);

      select(0, { scroll: false });
    };

    input.addEventListener('input', filter);

    input.addEventListener('keydown', (event) => {
      const step =
        event.key === 'ArrowDown' || (event.ctrlKey && event.key === 'n')
          ? 1
          : event.key === 'ArrowUp' || (event.ctrlKey && event.key === 'p')
            ? -1
            : 0;

      if (step) {
        event.preventDefault();
        // Wrap so the list behaves like a dial rather than dead-ending.
        select((active + step + visible.length) % visible.length);
        return;
      }

      if (event.key === 'Enter' && visible.length) {
        event.preventDefault();
        const href = visible[active].href;
        if (event.metaKey || event.ctrlKey) window.open(href, '_blank', 'noopener');
        else window.location.href = href;
        return;
      }

      if (event.key === 'Escape') {
        event.preventDefault();
        input.value = '';
        filter();
      }
    });

    for (const row of rows) {
      row.addEventListener('pointerenter', () => {
        const at = visible.indexOf(row);
        if (at >= 0) select(at, { scroll: false });
      });
      row.addEventListener('focus', () => {
        const at = visible.indexOf(row);
        if (at >= 0) select(at, { scroll: false });
      });
    }

    // The console owns the keyboard: start typing anywhere and the query takes it.
    window.addEventListener('keydown', (event) => {
      if (document.activeElement === input) return;
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      if (event.key === '/' || event.key.length === 1) {
        input.focus();
        if (event.key === '/') event.preventDefault();
      }
    });

    filter();
    input.focus({ preventScroll: true });
  }
</script>

<style is:global>
  html,
  body {
    overflow: hidden;
  }
</style>

<style>
  .console {
    position: relative;
    z-index: 2;
    height: 100vh;
    height: 100svh;
    display: grid;
    place-items: center;
    padding: 96px var(--gutter) 40px;
  }

  /* Hairline frame floating over the lattice — blurred for legibility, never glossy. */
  .frame {
    width: min(var(--measure), 100%);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    /* Sized to the full list so nothing jumps as the query narrows it. */
    height: min(482px, 100%);
    border: 1px solid var(--rule);
    background: rgba(5, 6, 7, 0.58);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    animation: frame-in 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .query {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 20px;
    height: 54px;
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .query__prompt {
    color: rgba(232, 236, 238, 0.4);
  }

  .query__sep {
    color: var(--accent);
  }

  .query__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink-bright);
    font: inherit;
    letter-spacing: 0.1em;
    text-transform: none;
    outline: none;
  }

  .query__input::placeholder {
    color: rgba(232, 236, 238, 0.28);
  }

  .query__count {
    color: rgba(232, 236, 238, 0.4);
    font-variant-numeric: tabular-nums;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
    min-height: 0;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(232, 236, 238, 0.18) transparent;
  }

  .list__item + .list__item .row {
    border-top: 1px solid rgba(232, 236, 238, 0.06);
  }

  .list__empty {
    padding: 26px 20px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(232, 236, 238, 0.35);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 14px;
    padding: 0 20px;
    height: 54px;
    color: var(--ink);
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  /* Accent bar marks the active row instead of a filled highlight block. */
  .row::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .row[aria-selected='true'] {
    background: rgba(34, 211, 238, 0.05);
  }

  .row[aria-selected='true']::before {
    transform: scaleY(1);
  }

  .row__n {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: rgba(232, 236, 238, 0.3);
    font-variant-numeric: tabular-nums;
  }

  .row__mark {
    display: block;
    width: 17px;
    height: 17px;
    --mark-stroke: 1.15;
    color: rgba(232, 236, 238, 0.45);
    transition: color 160ms ease;
  }

  .row__label {
    font-size: 14px;
    letter-spacing: -0.005em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row__host {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(232, 236, 238, 0.28);
    white-space: nowrap;
  }

  .row__go {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .row[aria-selected='true'] .row__n,
  .row[aria-selected='true'] .row__mark {
    color: var(--accent);
  }

  .row[aria-selected='true'] .row__label {
    color: var(--ink-bright);
  }

  .row[aria-selected='true'] .row__go {
    opacity: 1;
  }

  .detail {
    position: relative;
    display: grid;
    border-left: 1px solid var(--rule);
    min-height: 0;
  }

  .card {
    grid-area: 1 / 1;
    align-content: center;
    display: grid;
    gap: 0;
    padding: 28px;
    min-width: 0;
    animation: card-in 320ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .card[hidden] {
    display: none;
  }

  .card__n {
    position: absolute;
    top: 20px;
    right: 26px;
    font-family: var(--mono);
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.04em;
    color: rgba(232, 236, 238, 0.05);
    font-variant-numeric: tabular-nums;
  }

  .card__mark {
    display: block;
    width: 46px;
    height: 46px;
    margin-bottom: 26px;
    --mark-stroke: 1.25;
    color: var(--accent);
  }

  .card__label {
    margin: 0 0 10px;
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--ink-bright);
  }

  .card__note {
    margin: 0 0 18px;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(232, 236, 238, 0.5);
  }

  .card__url {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(232, 236, 238, 0.34);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .keys {
    display: flex;
    gap: 22px;
    margin: 0;
    padding: 0 20px;
    height: 42px;
    align-items: center;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(232, 236, 238, 0.3);
  }

  .keys span {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  kbd {
    display: grid;
    place-items: center;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border: 1px solid rgba(232, 236, 238, 0.14);
    font: inherit;
    letter-spacing: 0;
    color: rgba(232, 236, 238, 0.45);
  }

  @media (max-width: 860px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }

    .detail {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .console {
      padding: 84px var(--gutter) 28px;
    }

    .row__host {
      display: none;
    }

    .keys {
      gap: 14px;
    }
  }

  @keyframes frame-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame,
    .card,
    .row,
    .row::before {
      animation: none;
      transition: none;
    }
  }
</style>
