---
import Layout from '../layouts/Layout.astro';
import Lattice from '../components/Lattice.astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = 'Marxvim — Systems';
const description = 'Directory for Marxvim systems.';

const destinations = [
  {
    label: 'Home',
    hint: 'marxvim.com',
    href: 'https://marxvim.com',
    icon: 'home',
  },
  {
    label: 'Enterprise Console',
    hint: 'enterprise.marxvim.com',
    href: 'https://enterprise.marxvim.com',
    icon: 'console',
  },
  {
    label: 'n8n',
    hint: 'n8n.marxvim.com',
    href: 'https://n8n.marxvim.com',
    icon: 'n8n',
  },
  {
    label: 'Langfuse',
    hint: 'observability',
    href: 'https://4b51-2601-447-d080-cc80-41d9-8112-26f-595c.ngrok-free.app/',
    icon: 'langfuse',
  },
  {
    label: 'GitHub',
    hint: 'github.com/marxvim',
    href: 'https://github.com/marxvim',
    icon: 'github',
  },
  {
    label: 'Node Enterprise',
    hint: 'app.nodeenterprise.ai',
    href: 'https://app.nodeenterprise.ai/',
    icon: 'node',
  },
  {
    label: 'Fortify Risk',
    hint: 'fortifyriskai-lp-app.vercel.app',
    href: 'https://fortifyriskai-lp-app.vercel.app/',
    icon: 'fortify',
  },
] as const;
---

<Layout title={title} description={description}>
  <Lattice />
  <SiteHeader />

  <main class="gate">
    <div class="gate__lead rise rise--1">
      <div>
        <h1 class="visually-hidden">Marxvim systems</h1>
        <p class="eyebrow">Select a system</p>
      </div>

      <label class="finder">
        <span class="finder__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
            <circle cx="10.5" cy="10.5" r="6" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M15.2 15.2L20 20" stroke="currentColor" stroke-width="1.6"></path>
          </svg>
        </span>
        <input
          class="finder__input"
          type="search"
          placeholder="Search systems"
          autocomplete="off"
          spellcheck="false"
        />
      </label>
    </div>

    <nav class="sys-rail" aria-label="Marxvim systems">
      {
        destinations.map((item, i) => (
          <a
            class="sys-tile rise"
            href={item.href}
            rel="noopener"
            style={`--i:${i}`}
            data-search={`${item.label} ${item.hint} ${item.href}`.toLowerCase()}
          >
            <span class={`glass glass--${item.icon}`} aria-hidden="true">
              <span class="glass__plate">
                <span class="glass__sheen"></span>
                <span class="glass__spec"></span>
                <span class="glass__mark">
                  {item.icon === 'home' && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <rect class="draw sq-a" x="8" y="8" width="18" height="18" />
                      <rect class="draw sq-b" x="22" y="22" width="18" height="18" />
                    </svg>
                  )}
                  {item.icon === 'console' && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <rect class="draw" x="7" y="10" width="34" height="28" />
                      <path class="caret" d="M13 20l6 4-6 4" />
                      <path class="prompt" d="M22 28h10" />
                    </svg>
                  )}
                  {item.icon === 'n8n' && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <path class="edge" d="M16.2 21.4L19.8 16.2M16.2 26.6L19.8 31.8M28.2 16.2L31.8 21.4M28.2 31.8L31.8 26.6" />
                      <circle class="node n1" cx="12" cy="24" r="4.5" />
                      <circle class="node n2" cx="24" cy="13" r="4.5" />
                      <circle class="node n3" cx="24" cy="35" r="4.5" />
                      <circle class="node n4" cx="36" cy="24" r="4.5" />
                    </svg>
                  )}
                  {item.icon === 'langfuse' && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <path class="bar b1" d="M10 32V16" />
                      <path class="bar b2" d="M20 32V12" />
                      <path class="bar b3" d="M30 32V20" />
                      <path class="bar b4" d="M38 32V8" />
                      <circle class="dot d1" cx="10" cy="16" r="2.2" />
                      <circle class="dot d2" cx="20" cy="12" r="2.2" />
                      <circle class="dot d3" cx="30" cy="20" r="2.2" />
                      <circle class="dot d4" cx="38" cy="8" r="2.2" />
                    </svg>
                  )}
                  {item.icon === 'github' && (
                    <svg class="octo" viewBox="0 0 48 48" fill="currentColor">
                      <path d="M24 6C14.1 6 6 14.2 6 24.2c0 8 5.2 14.8 12.4 17.2.9.2 1.2-.4 1.2-.9v-3.3c-5 .1-6.1-2.4-6.1-2.4-.8-2.1-2-2.7-2-2.7-1.6-1.1.1-1.1.1-1.1 1.8.1 2.8 1.9 2.8 1.9 1.6 2.8 4.2 2 5.2 1.5.2-1.2.6-2 .1-2.5-4-.5-8.2-2-8.2-9 0-2 .7-3.6 1.8-4.9-.2-.5-.8-2.3.2-4.7 0 0 1.5-.5 5 1.9 1.4-.4 3-.6 4.6-.6s3.2.2 4.6.6c3.5-2.4 5-1.9 5-1.9 1 2.4.4 4.2.2 4.7 1.1 1.3 1.8 2.9 1.8 4.9 0 7-4.2 8.5-8.2 9 .7.6 1.3 1.8 1.3 3.6v5.3c0 .5.3 1.1 1.2.9C36.8 39 42 32.2 42 24.2 42 14.2 33.9 6 24 6z" />
                    </svg>
                  )}
                  {item.icon === 'node' && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <path class="edge" d="M18 18.5L24 13M30 18.5L24 13M18 29.5L24 35M30 29.5L24 35M16.5 22L16.5 26M31.5 22L31.5 26" />
                      <circle class="node n1" cx="16" cy="20" r="4" />
                      <circle class="node n2" cx="32" cy="20" r="4" />
                      <circle class="node n3" cx="16" cy="28" r="4" />
                      <circle class="node n4" cx="32" cy="28" r="4" />
                      <circle class="node n5" cx="24" cy="12" r="3.4" />
                      <circle class="node n6" cx="24" cy="36" r="3.4" />
                    </svg>
                  )}
                  {item.icon === 'fortify' && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <path class="shield" d="M24 8l14 6v10c0 9.2-6.2 14.8-14 17-7.8-2.2-14-7.8-14-17V14z" />
                      <path class="check" d="M17 24l5 5 9-10" />
                    </svg>
                  )}
                </span>
              </span>
            </span>
            <span class="sys-tile__label">{item.label}</span>
            <span class="sys-tile__hint">{item.hint}</span>
          </a>
        ))
      }
      <p class="sys-empty" hidden>No systems match.</p>
    </nav>
  </main>
</Layout>

<script>
  const rail = document.querySelector('.sys-rail');
  const input = document.querySelector('.finder__input');
  const tiles = [...document.querySelectorAll('.sys-tile')];
  const empty = document.querySelector('.sys-empty');

  if (rail instanceof HTMLElement) {
    rail.addEventListener(
      'wheel',
      (event) => {
        if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
        event.preventDefault();
        rail.scrollLeft += event.deltaY;
      },
      { passive: false },
    );
  }

  if (input instanceof HTMLInputElement && empty instanceof HTMLElement) {
    const filter = () => {
      const query = input.value.trim().toLowerCase();
      let shown = 0;
      for (const tile of tiles) {
        if (!(tile instanceof HTMLElement)) continue;
        const hay = tile.dataset.search ?? '';
        const match = query.length === 0 || hay.includes(query);
        tile.hidden = !match;
        if (match) shown += 1;
      }
      empty.hidden = shown > 0;
    };

    input.addEventListener('input', filter);
    window.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== input) {
        event.preventDefault();
        input.focus();
      }
      if (event.key === 'Escape' && document.activeElement === input) {
        input.value = '';
        filter();
        input.blur();
      }
    });
  }
</script>

<style is:global>
  html,
  body {
    overflow-y: hidden;
  }
</style>

<style>
  .gate {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: 28px;
    padding: 110px 0 48px;
  }

  .gate__lead {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    padding: 0 var(--gutter);
  }

  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .finder {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: min(320px, 52vw);
    padding: 0 14px;
    border: 1px solid rgba(232, 236, 238, 0.18);
    background: rgba(5, 6, 7, 0.55);
    color: rgba(232, 236, 238, 0.55);
    backdrop-filter: blur(14px);
  }

  .finder:focus-within {
    border-color: var(--accent);
    color: var(--accent);
  }

  .finder__icon {
    display: grid;
  }

  .finder__input {
    flex: 1;
    min-width: 0;
    height: 42px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    outline: none;
  }

  .finder__input::placeholder {
    color: rgba(232, 236, 238, 0.38);
    text-transform: uppercase;
  }

  .sys-rail {
    display: flex;
    align-items: stretch;
    gap: 1px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    background: var(--rule);
    border-block: 1px solid var(--rule);
    padding-inline: var(--gutter);
    scrollbar-color: rgba(34, 211, 238, 0.45) transparent;
    scrollbar-width: thin;
  }

  .sys-rail::-webkit-scrollbar {
    height: 4px;
  }

  .sys-rail::-webkit-scrollbar-thumb {
    background: rgba(34, 211, 238, 0.4);
  }

  .sys-empty {
    margin: 0;
    padding: 48px 8px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(232, 236, 238, 0.42);
    white-space: nowrap;
  }

  .sys-tile {
    position: relative;
    isolation: isolate;
    flex: 0 0 228px;
    display: grid;
    justify-items: start;
    align-content: end;
    gap: 10px;
    height: 228px;
    padding: 22px 20px;
    background: rgba(5, 6, 7, 0.42);
    color: var(--ink);
    overflow: hidden;
    scroll-snap-align: start;
    transition:
      color 220ms ease,
      background-color 260ms ease;
  }

  .sys-tile[hidden] {
    display: none;
  }

  .sys-tile::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .sys-tile:hover,
  .sys-tile:focus-visible {
    color: var(--ink-bright);
    background-color: rgba(9, 15, 18, 0.28);
  }

  .sys-tile:hover::after,
  .sys-tile:focus-visible::after {
    transform: scaleX(1);
  }

  .glass {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 64px;
    height: 64px;
    perspective: 320px;
  }

  .glass__plate {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 20px;
    overflow: hidden;
    color: #e8fbff;
    background:
      linear-gradient(155deg, rgba(255, 255, 255, 0.34) 0%, rgba(34, 211, 238, 0.12) 38%, rgba(255, 255, 255, 0.05) 72%),
      rgba(12, 22, 26, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.32);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 -18px 28px rgba(34, 211, 238, 0.08),
      0 18px 40px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    transform-style: preserve-3d;
  }

  .glass__sheen,
  .glass__spec {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .glass__sheen {
    background: linear-gradient(
      115deg,
      transparent 30%,
      rgba(255, 255, 255, 0.08) 44%,
      rgba(255, 255, 255, 0.55) 50%,
      rgba(34, 211, 238, 0.18) 56%,
      transparent 70%
    );
    transform: translateX(-120%);
  }

  .glass__spec {
    background: radial-gradient(circle at 28% 22%, rgba(255, 255, 255, 0.62), transparent 34%);
  }

  .glass__mark {
    position: relative;
    z-index: 1;
    width: 34px;
    height: 34px;
    color: rgba(232, 251, 255, 0.94);
    filter: drop-shadow(0 0 10px rgba(34, 211, 238, 0.35));
  }

  .glass__mark svg {
    width: 100%;
    height: 100%;
  }

  .glass__mark .draw,
  .glass__mark .caret,
  .glass__mark .prompt,
  .glass__mark .edge,
  .glass__mark .node,
  .glass__mark .bar,
  .glass__mark .shield,
  .glass__mark .check {
    stroke: currentColor;
    stroke-width: 1.7;
  }

  .glass__mark .dot {
    fill: currentColor;
  }

  .sys-tile__label {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .sys-tile__hint {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(232, 236, 238, 0.42);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  @media (max-width: 640px) {
    .gate__lead {
      flex-direction: column;
      align-items: stretch;
    }

    .finder {
      min-width: 0;
    }

    .sys-tile {
      flex-basis: 200px;
      height: 208px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .sys-tile.rise {
      animation-delay: calc(120ms + var(--i) * 70ms);
    }

    .glass__plate {
      animation: glass-float 5.6s ease-in-out calc(var(--i) * 0.45s) infinite;
    }

    .glass__sheen {
      animation: glass-sheen 4.8s cubic-bezier(0.4, 0, 0.2, 1) calc(var(--i) * 0.55s) infinite;
    }

    .sys-tile:hover .glass__plate,
    .sys-tile:focus-visible .glass__plate {
      animation-play-state: paused;
      transform: rotateX(10deg) rotateY(-12deg) translateY(-4px);
    }

    .sys-tile:hover .glass__sheen,
    .sys-tile:focus-visible .glass__sheen {
      animation-duration: 1.6s;
    }

    .glass--home .sq-a {
      animation: home-a 3.4s ease-in-out infinite;
    }

    .glass--home .sq-b {
      animation: home-b 3.4s ease-in-out infinite;
    }

    .glass--console .caret {
      animation: caret-nudge 1.8s ease-in-out infinite;
    }

    .glass--console .prompt {
      stroke-dasharray: 12;
      animation: prompt-type 2.4s ease-in-out infinite;
    }

    .glass--n8n .node,
    .glass--node .node {
      transform-box: fill-box;
      transform-origin: center;
      animation: node-pulse 2.2s ease-in-out infinite;
    }

    .glass--n8n .n2,
    .glass--node .n2 {
      animation-delay: 0.2s;
    }
    .glass--n8n .n3,
    .glass--node .n3 {
      animation-delay: 0.4s;
    }
    .glass--n8n .n4,
    .glass--node .n4 {
      animation-delay: 0.6s;
    }
    .glass--node .n5 {
      animation-delay: 0.3s;
    }
    .glass--node .n6 {
      animation-delay: 0.5s;
    }

    .glass--n8n .edge,
    .glass--node .edge {
      stroke-dasharray: 8 6;
      animation: edge-flow 1.6s linear infinite;
    }

    .glass--langfuse .bar {
      transform-box: fill-box;
      transform-origin: bottom;
    }

    .glass--langfuse .b1 {
      animation: bar-wave 1.8s ease-in-out infinite;
    }
    .glass--langfuse .b2 {
      animation: bar-wave 1.8s ease-in-out 0.15s infinite;
    }
    .glass--langfuse .b3 {
      animation: bar-wave 1.8s ease-in-out 0.3s infinite;
    }
    .glass--langfuse .b4 {
      animation: bar-wave 1.8s ease-in-out 0.45s infinite;
    }

    .glass--langfuse .dot {
      animation: dot-glow 1.8s ease-in-out infinite;
    }
    .glass--langfuse .d2 {
      animation-delay: 0.15s;
    }
    .glass--langfuse .d3 {
      animation-delay: 0.3s;
    }
    .glass--langfuse .d4 {
      animation-delay: 0.45s;
    }

    .glass--github .octo {
      animation: octo-breathe 3.2s ease-in-out infinite;
    }

    .glass--fortify .shield {
      transform-box: fill-box;
      transform-origin: center;
      animation: shield-pulse 2.6s ease-in-out infinite;
    }

    .glass--fortify .check {
      stroke-dasharray: 28;
      animation: prompt-type 2.2s ease-in-out infinite;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes glass-float {
    0%,
    100% {
      transform: rotateX(4deg) rotateY(-6deg) translateY(0);
    }
    50% {
      transform: rotateX(-5deg) rotateY(7deg) translateY(-5px);
    }
  }

  @keyframes glass-sheen {
    0%,
    18% {
      transform: translateX(-120%);
    }
    48%,
    100% {
      transform: translateX(120%);
    }
  }

  @keyframes home-a {
    50% {
      transform: translate(2px, -2px);
    }
  }

  @keyframes home-b {
    50% {
      transform: translate(-2px, 2px);
    }
  }

  @keyframes caret-nudge {
    50% {
      opacity: 0.35;
      transform: translateX(2px);
    }
  }

  @keyframes prompt-type {
    0%,
    20% {
      stroke-dashoffset: 12;
    }
    50%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes node-pulse {
    50% {
      transform: scale(1.18);
      fill: rgba(34, 211, 238, 0.18);
    }
  }

  @keyframes edge-flow {
    to {
      stroke-dashoffset: -14;
    }
  }

  @keyframes bar-wave {
    0%,
    100% {
      transform: scaleY(0.72);
    }
    50% {
      transform: scaleY(1.12);
    }
  }

  @keyframes dot-glow {
    50% {
      opacity: 0.45;
    }
  }

  @keyframes octo-breathe {
    50% {
      transform: scale(1.06);
      filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.45));
    }
  }

  @keyframes shield-pulse {
    50% {
      transform: scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sys-tile,
    .sys-tile::after,
    .glass__plate {
      transition: none;
    }
  }
</style>
