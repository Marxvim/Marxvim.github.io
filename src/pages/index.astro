---
import Layout from '../layouts/Layout.astro';
import Lattice from '../components/Lattice.astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = 'Marxvim — Systems';
const description = 'Directory for Marxvim systems: site, console, n8n, Langfuse, and GitHub.';

const destinations = [
  {
    label: 'Home',
    hint: 'marxvim.com',
    href: 'https://marxvim.com',
    icon: 'home',
  },
  {
    label: 'Enterprise Console',
    hint: 'enterprise.marxvim.com',
    href: 'https://enterprise.marxvim.com',
    icon: 'console',
  },
  {
    label: 'n8n',
    hint: 'n8n.marxvim.com',
    href: 'https://n8n.marxvim.com',
    icon: 'n8n',
  },
  {
    label: 'Langfuse',
    hint: 'observability',
    href: 'https://4b51-2601-447-d080-cc80-41d9-8112-26f-595c.ngrok-free.app/',
    icon: 'langfuse',
  },
  {
    label: 'GitHub',
    hint: 'github.com/marxvim',
    href: 'https://github.com/marxvim',
    icon: 'github',
  },
] as const;
---

<Layout title={title} description={description}>
  <Lattice />
  <SiteHeader />

  <main class="gate">
    <div class="gate__lead rise rise--1">
      <h1 class="visually-hidden">Marxvim systems</h1>
      <p class="eyebrow">Select a system</p>
    </div>

    <nav class="sys-grid" aria-label="Marxvim systems">
      {
        destinations.map((item, i) => (
          <a
            class={`sys-tile rise rise--${i + 2}`}
            href={item.href}
            rel="noopener"
            style={`--i:${i}`}
            data-slot={i}
          >
            <span class={`glass glass--${item.icon}`} aria-hidden="true">
              <span class="glass__plate">
                <span class="glass__sheen"></span>
                <span class="glass__spec"></span>
                <span class="glass__mark">
                  {item.icon === 'home' && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <rect class="draw sq-a" x="8" y="8" width="18" height="18" />
                      <rect class="draw sq-b" x="22" y="22" width="18" height="18" />
                    </svg>
                  )}
                  {item.icon === 'console' && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <rect class="draw" x="7" y="10" width="34" height="28" />
                      <path class="caret" d="M13 20l6 4-6 4" />
                      <path class="prompt" d="M22 28h10" />
                    </svg>
                  )}
                  {item.icon === 'n8n' && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <path class="edge" d="M16.2 21.4L19.8 16.2M16.2 26.6L19.8 31.8M28.2 16.2L31.8 21.4M28.2 31.8L31.8 26.6" />
                      <circle class="node n1" cx="12" cy="24" r="4.5" />
                      <circle class="node n2" cx="24" cy="13" r="4.5" />
                      <circle class="node n3" cx="24" cy="35" r="4.5" />
                      <circle class="node n4" cx="36" cy="24" r="4.5" />
                    </svg>
                  )}
                  {item.icon === 'langfuse' && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <path class="bar b1" d="M10 32V16" />
                      <path class="bar b2" d="M20 32V12" />
                      <path class="bar b3" d="M30 32V20" />
                      <path class="bar b4" d="M38 32V8" />
                      <circle class="dot d1" cx="10" cy="16" r="2.2" />
                      <circle class="dot d2" cx="20" cy="12" r="2.2" />
                      <circle class="dot d3" cx="30" cy="20" r="2.2" />
                      <circle class="dot d4" cx="38" cy="8" r="2.2" />
                    </svg>
                  )}
                  {item.icon === 'github' && (
                    <svg class="octo" viewBox="0 0 48 48" fill="currentColor">
                      <path d="M24 6C14.1 6 6 14.2 6 24.2c0 8 5.2 14.8 12.4 17.2.9.2 1.2-.4 1.2-.9v-3.3c-5 .1-6.1-2.4-6.1-2.4-.8-2.1-2-2.7-2-2.7-1.6-1.1.1-1.1.1-1.1 1.8.1 2.8 1.9 2.8 1.9 1.6 2.8 4.2 2 5.2 1.5.2-1.2.6-2 .1-2.5-4-.5-8.2-2-8.2-9 0-2 .7-3.6 1.8-4.9-.2-.5-.8-2.3.2-4.7 0 0 1.5-.5 5 1.9 1.4-.4 3-.6 4.6-.6s3.2.2 4.6.6c3.5-2.4 5-1.9 5-1.9 1 2.4.4 4.2.2 4.7 1.1 1.3 1.8 2.9 1.8 4.9 0 7-4.2 8.5-8.2 9 .7.6 1.3 1.8 1.3 3.6v5.3c0 .5.3 1.1 1.2.9C36.8 39 42 32.2 42 24.2 42 14.2 33.9 6 24 6z" />
                    </svg>
                  )}
                </span>
              </span>
            </span>
            <span class="sys-tile__label">{item.label}</span>
            <span class="sys-tile__hint">{item.hint}</span>
          </a>
        ))
      }
    </nav>
  </main>
</Layout>

<style>
  .gate {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 22px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 104px var(--gutter) 36px;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .sys-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: 1fr 1fr;
    gap: 1px;
    min-height: 0;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .sys-tile {
    position: relative;
    isolation: isolate;
    grid-column: span 2;
    display: grid;
    justify-items: start;
    align-content: end;
    gap: 14px;
    min-height: 0;
    padding: 34px 32px;
    background: rgba(5, 6, 7, 0.42);
    color: var(--ink);
    overflow: hidden;
    transition:
      color 220ms ease,
      background-color 260ms ease;
  }

  .sys-tile:nth-child(4) {
    grid-column: 1 / span 3;
  }

  .sys-tile:nth-child(5) {
    grid-column: 4 / span 3;
  }

  .sys-tile::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .sys-tile:hover,
  .sys-tile:focus-visible {
    color: var(--ink-bright);
    background-color: rgba(9, 15, 18, 0.28);
  }

  .sys-tile:hover::after,
  .sys-tile:focus-visible::after {
    transform: scaleX(1);
  }

  .glass {
    position: absolute;
    top: 28px;
    left: 32px;
    width: 88px;
    height: 88px;
    perspective: 320px;
  }

  .glass__plate {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 26px;
    overflow: hidden;
    color: #e8fbff;
    background:
      linear-gradient(155deg, rgba(255, 255, 255, 0.34) 0%, rgba(34, 211, 238, 0.12) 38%, rgba(255, 255, 255, 0.05) 72%),
      rgba(12, 22, 26, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.32);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 -18px 28px rgba(34, 211, 238, 0.08),
      0 18px 40px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    transform-style: preserve-3d;
  }

  .glass__sheen,
  .glass__spec {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .glass__sheen {
    background: linear-gradient(
      115deg,
      transparent 30%,
      rgba(255, 255, 255, 0.08) 44%,
      rgba(255, 255, 255, 0.55) 50%,
      rgba(34, 211, 238, 0.18) 56%,
      transparent 70%
    );
    transform: translateX(-120%);
  }

  .glass__spec {
    background: radial-gradient(circle at 28% 22%, rgba(255, 255, 255, 0.62), transparent 34%);
  }

  .glass__mark {
    position: relative;
    z-index: 1;
    width: 46px;
    height: 46px;
    color: rgba(232, 251, 255, 0.94);
    filter: drop-shadow(0 0 10px rgba(34, 211, 238, 0.35));
  }

  .glass__mark svg {
    width: 100%;
    height: 100%;
  }

  .glass__mark .draw,
  .glass__mark .caret,
  .glass__mark .prompt,
  .glass__mark .edge,
  .glass__mark .node,
  .glass__mark .bar {
    stroke: currentColor;
    stroke-width: 1.7;
  }

  .glass__mark .dot {
    fill: currentColor;
  }

  .sys-tile__label {
    font-size: clamp(22px, 2.4vw, 34px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .sys-tile__hint {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(232, 236, 238, 0.42);
  }

  @media (max-width: 900px) {
    .sys-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
    }

    .sys-tile,
    .sys-tile:nth-child(4),
    .sys-tile:nth-child(5) {
      grid-column: auto;
    }

    .sys-tile:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .gate {
      padding: 96px var(--gutter) 28px;
    }

    .sys-grid {
      grid-template-columns: 1fr;
    }

    .sys-tile,
    .sys-tile:last-child {
      grid-column: auto;
      min-height: 148px;
      padding: 22px 20px;
    }

    .glass {
      top: 18px;
      left: 18px;
      width: 64px;
      height: 64px;
    }

    .glass__plate {
      border-radius: 20px;
    }

    .glass__mark {
      width: 34px;
      height: 34px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .rise--1 {
      animation-delay: 80ms;
    }
    .rise--2 {
      animation-delay: 140ms;
    }
    .rise--3 {
      animation-delay: 220ms;
    }
    .rise--4 {
      animation-delay: 300ms;
    }
    .rise--5 {
      animation-delay: 380ms;
    }
    .rise--6 {
      animation-delay: 460ms;
    }

    .glass__plate {
      animation: glass-float 5.6s ease-in-out calc(var(--i) * 0.45s) infinite;
    }

    .glass__sheen {
      animation: glass-sheen 4.8s cubic-bezier(0.4, 0, 0.2, 1) calc(var(--i) * 0.55s) infinite;
    }

    .sys-tile:hover .glass__plate,
    .sys-tile:focus-visible .glass__plate {
      animation-play-state: paused;
      transform: rotateX(10deg) rotateY(-12deg) translateY(-4px);
    }

    .sys-tile:hover .glass__sheen,
    .sys-tile:focus-visible .glass__sheen {
      animation-duration: 1.6s;
    }

    .glass--home .sq-a {
      animation: home-a 3.4s ease-in-out infinite;
    }

    .glass--home .sq-b {
      animation: home-b 3.4s ease-in-out infinite;
    }

    .glass--console .caret {
      animation: caret-nudge 1.8s ease-in-out infinite;
    }

    .glass--console .prompt {
      stroke-dasharray: 12;
      animation: prompt-type 2.4s ease-in-out infinite;
    }

    .glass--n8n .node {
      transform-box: fill-box;
      transform-origin: center;
      animation: node-pulse 2.2s ease-in-out infinite;
    }

    .glass--n8n .n2 {
      animation-delay: 0.2s;
    }
    .glass--n8n .n3 {
      animation-delay: 0.4s;
    }
    .glass--n8n .n4 {
      animation-delay: 0.6s;
    }

    .glass--n8n .edge {
      stroke-dasharray: 8 6;
      animation: edge-flow 1.6s linear infinite;
    }

    .glass--langfuse .bar {
      transform-box: fill-box;
      transform-origin: bottom;
    }

    .glass--langfuse .b1 {
      animation: bar-wave 1.8s ease-in-out infinite;
    }
    .glass--langfuse .b2 {
      animation: bar-wave 1.8s ease-in-out 0.15s infinite;
    }
    .glass--langfuse .b3 {
      animation: bar-wave 1.8s ease-in-out 0.3s infinite;
    }
    .glass--langfuse .b4 {
      animation: bar-wave 1.8s ease-in-out 0.45s infinite;
    }

    .glass--langfuse .dot {
      animation: dot-glow 1.8s ease-in-out infinite;
    }
    .glass--langfuse .d2 {
      animation-delay: 0.15s;
    }
    .glass--langfuse .d3 {
      animation-delay: 0.3s;
    }
    .glass--langfuse .d4 {
      animation-delay: 0.45s;
    }

    .glass--github .octo {
      animation: octo-breathe 3.2s ease-in-out infinite;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes glass-float {
    0%,
    100% {
      transform: rotateX(4deg) rotateY(-6deg) translateY(0);
    }
    50% {
      transform: rotateX(-5deg) rotateY(7deg) translateY(-5px);
    }
  }

  @keyframes glass-sheen {
    0%,
    18% {
      transform: translateX(-120%);
    }
    48%,
    100% {
      transform: translateX(120%);
    }
  }

  @keyframes home-a {
    50% {
      transform: translate(2px, -2px);
    }
  }

  @keyframes home-b {
    50% {
      transform: translate(-2px, 2px);
    }
  }

  @keyframes caret-nudge {
    50% {
      opacity: 0.35;
      transform: translateX(2px);
    }
  }

  @keyframes prompt-type {
    0%,
    20% {
      stroke-dashoffset: 12;
    }
    50%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes node-pulse {
    50% {
      transform: scale(1.18);
      fill: rgba(34, 211, 238, 0.18);
    }
  }

  @keyframes edge-flow {
    to {
      stroke-dashoffset: -14;
    }
  }

  @keyframes bar-wave {
    0%,
    100% {
      transform: scaleY(0.72);
    }
    50% {
      transform: scaleY(1.12);
    }
  }

  @keyframes dot-glow {
    50% {
      opacity: 0.45;
    }
  }

  @keyframes octo-breathe {
    50% {
      transform: scale(1.06);
      filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.45));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sys-tile,
    .sys-tile::after,
    .glass__plate {
      transition: none;
    }
  }
</style>
