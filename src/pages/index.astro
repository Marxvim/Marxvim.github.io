---
import Layout from '../layouts/Layout.astro';
import Lattice from '../components/Lattice.astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = 'Marxvim — Systems';
const description = 'Directory for Marxvim systems: site, console, n8n, Langfuse, and GitHub.';

const destinations = [
  {
    index: '01',
    label: 'Home',
    hint: 'marxvim.com',
    href: 'https://marxvim.com',
  },
  {
    index: '02',
    label: 'Enterprise Console',
    hint: 'enterprise.marxvim.com',
    href: 'https://enterprise.marxvim.com',
  },
  {
    index: '03',
    label: 'n8n',
    hint: 'n8n.marxvim.com',
    href: 'https://n8n.marxvim.com',
  },
  {
    index: '04',
    label: 'Langfuse',
    hint: 'observability',
    href: 'https://4b51-2601-447-d080-cc80-41d9-8112-26f-595c.ngrok-free.app/',
  },
  {
    index: '05',
    label: 'GitHub',
    hint: 'github.com/marxvim',
    href: 'https://github.com/marxvim',
  },
];
---

<Layout title={title} description={description}>
  <Lattice />
  <SiteHeader />

  <main class="gate">
    <div class="gate__lead rise rise--1">
      <h1 class="visually-hidden">Marxvim systems</h1>
      <p class="eyebrow">Select a system</p>
    </div>

    <nav class="sys-index" aria-label="Marxvim systems">
      {
        destinations.map((item, i) => (
          <a class={`sys-row rise rise--${i + 2}`} href={item.href} rel="noopener">
            <span class="sys-row__n">{item.index}</span>
            <span class="sys-row__copy">
              <span class="sys-row__label">{item.label}</span>
              <span class="sys-row__hint">{item.hint}</span>
            </span>
            <span class="sys-row__go" aria-hidden="true">↗</span>
          </a>
        ))
      }
    </nav>
  </main>
</Layout>

<style>
  .gate {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: stretch;
    gap: 22px;
    max-width: var(--measure);
    margin: 0 auto;
    padding: 104px var(--gutter) 36px;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .sys-index {
    display: grid;
    grid-template-rows: repeat(5, 1fr);
    gap: 1px;
    min-height: 0;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .sys-row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 72px 1fr auto;
    align-items: center;
    gap: 22px;
    min-height: 0;
    padding: 22px 32px;
    background: var(--panel);
    color: var(--ink);
    overflow: hidden;
    transition: color 220ms ease;
  }

  .sys-row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(34, 211, 238, 0.1), transparent 58%);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 480ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .sys-row::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 1px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 480ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .sys-row:hover,
  .sys-row:focus-visible {
    color: var(--ink-bright);
  }

  .sys-row:hover::before,
  .sys-row:focus-visible::before,
  .sys-row:hover::after,
  .sys-row:focus-visible::after {
    transform: none;
  }

  .sys-row__n {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--accent);
  }

  .sys-row__copy {
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .sys-row__label {
    font-size: clamp(28px, 4.6vw, 56px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .sys-row__hint {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(232, 236, 238, 0.42);
  }

  .sys-row__go {
    color: var(--accent);
    font-size: 22px;
    opacity: 0;
    transform: translate(-8px, 8px);
    transition:
      opacity 260ms ease,
      transform 260ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .sys-row:hover .sys-row__go,
  .sys-row:focus-visible .sys-row__go {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 640px) {
    .gate {
      padding: 96px var(--gutter) 40px;
    }

    .sys-row {
      grid-template-columns: 44px 1fr;
      padding: 18px 16px;
    }

    .sys-row__go {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .rise--1 {
      animation-delay: 80ms;
    }
    .rise--2 {
      animation-delay: 140ms;
    }
    .rise--3 {
      animation-delay: 220ms;
    }
    .rise--4 {
      animation-delay: 300ms;
    }
    .rise--5 {
      animation-delay: 380ms;
    }
    .rise--6 {
      animation-delay: 460ms;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sys-row,
    .sys-row::before,
    .sys-row::after,
    .sys-row__go {
      transition: none;
    }
  }
</style>
