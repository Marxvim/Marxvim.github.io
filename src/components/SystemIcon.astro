---
/**
 * Hairline marks for each system. Stroke colour and width are inherited, so the
 * same mark works at 18px in the list and at 72px in the detail pane.
 */
interface Props {
  name: 'home' | 'console' | 'n8n' | 'langfuse' | 'github' | 'node' | 'fortify';
}

const { name } = Astro.props;
---

{
  name === 'home' && (
    <svg viewBox="0 0 48 48" fill="none">
      <rect class="sq-a" x="9" y="9" width="17" height="17" />
      <rect class="sq-b" x="22" y="22" width="17" height="17" />
    </svg>
  )
}
{
  name === 'console' && (
    <svg viewBox="0 0 48 48" fill="none">
      <rect x="7" y="11" width="34" height="26" />
      <path class="caret" d="M14 21l5 3.5-5 3.5" />
      <path class="prompt" d="M23 28h11" />
    </svg>
  )
}
{
  name === 'n8n' && (
    <svg viewBox="0 0 48 48" fill="none">
      <path class="edge" d="M16.4 21.6L19.6 16.4M16.4 26.4L19.6 31.6M28.4 16.4L31.6 21.6M28.4 31.6L31.6 26.4" />
      <circle class="node n1" cx="12" cy="24" r="4" />
      <circle class="node n2" cx="24" cy="13" r="4" />
      <circle class="node n3" cx="24" cy="35" r="4" />
      <circle class="node n4" cx="36" cy="24" r="4" />
    </svg>
  )
}
{
  name === 'langfuse' && (
    <svg viewBox="0 0 48 48" fill="none">
      <path class="bar b1" d="M11 34V20" />
      <path class="bar b2" d="M20 34V14" />
      <path class="bar b3" d="M29 34V24" />
      <path class="bar b4" d="M38 34V11" />
    </svg>
  )
}
{
  name === 'github' && (
    <svg class="octo" viewBox="0 0 48 48">
      <path d="M24 6C14.1 6 6 14.2 6 24.2c0 8 5.2 14.8 12.4 17.2.9.2 1.2-.4 1.2-.9v-3.3c-5 .1-6.1-2.4-6.1-2.4-.8-2.1-2-2.7-2-2.7-1.6-1.1.1-1.1.1-1.1 1.8.1 2.8 1.9 2.8 1.9 1.6 2.8 4.2 2 5.2 1.5.2-1.2.6-2 .1-2.5-4-.5-8.2-2-8.2-9 0-2 .7-3.6 1.8-4.9-.2-.5-.8-2.3.2-4.7 0 0 1.5-.5 5 1.9 1.4-.4 3-.6 4.6-.6s3.2.2 4.6.6c3.5-2.4 5-1.9 5-1.9 1 2.4.4 4.2.2 4.7 1.1 1.3 1.8 2.9 1.8 4.9 0 7-4.2 8.5-8.2 9 .7.6 1.3 1.8 1.3 3.6v5.3c0 .5.3 1.1 1.2.9C36.8 39 42 32.2 42 24.2 42 14.2 33.9 6 24 6z" />
    </svg>
  )
}
{
  name === 'node' && (
    <svg viewBox="0 0 48 48" fill="none">
      <path class="edge" d="M24 10.5L36 17.5M24 10.5L12 17.5M12 17.5V30.5M36 17.5V30.5M12 30.5L24 37.5M36 30.5L24 37.5" />
      <circle class="node n1" cx="24" cy="10.5" r="3.2" />
      <circle class="node n2" cx="36" cy="17.5" r="3.2" />
      <circle class="node n3" cx="36" cy="30.5" r="3.2" />
      <circle class="node n4" cx="24" cy="37.5" r="3.2" />
      <circle class="node n5" cx="12" cy="30.5" r="3.2" />
      <circle class="node n6" cx="12" cy="17.5" r="3.2" />
    </svg>
  )
}
{
  name === 'fortify' && (
    <svg viewBox="0 0 48 48" fill="none">
      <path class="shield" d="M24 8l14 5.5v10.2c0 8.7-6 14.3-14 16.3-8-2-14-7.6-14-16.3V13.5z" />
      <path class="check" d="M17.5 24l4.8 4.8L31 20" />
    </svg>
  )
}

<style is:global>
  /* non-scaling-stroke keeps the hairline a true hairline at every render size. */
  .mark svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: var(--mark-stroke, 1.1);
    stroke-linecap: square;
  }

  .mark svg * {
    vector-effect: non-scaling-stroke;
  }

  .mark .octo,
  .mark .octo * {
    fill: currentColor;
    stroke: none;
  }

  /* Motion is opt-in via .mark--live so only the focused, large mark animates. */
  @media (prefers-reduced-motion: no-preference) {
    .mark--live .sq-a {
      animation: mark-drift-a 6s ease-in-out infinite;
    }

    .mark--live .sq-b {
      animation: mark-drift-b 6s ease-in-out infinite;
    }

    .mark--live .caret {
      animation: mark-blink 2.4s steps(1, end) infinite;
    }

    .mark--live .node {
      transform-box: fill-box;
      transform-origin: center;
      animation: mark-ping 3.6s ease-in-out infinite;
      animation-delay: calc(var(--d, 0) * 1s);
    }

    .mark--live .n2 {
      --d: 0.18;
    }
    .mark--live .n3 {
      --d: 0.36;
    }
    .mark--live .n4 {
      --d: 0.54;
    }
    .mark--live .n5 {
      --d: 0.72;
    }
    .mark--live .n6 {
      --d: 0.9;
    }

    .mark--live .edge {
      stroke-dasharray: 3 5;
      animation: mark-flow 3s linear infinite;
    }

    .mark--live .bar {
      transform-box: fill-box;
      transform-origin: bottom;
      animation: mark-sample 3.2s ease-in-out infinite;
      animation-delay: calc(var(--d, 0) * 1s);
    }

    .mark--live .b2 {
      --d: 0.2;
    }
    .mark--live .b3 {
      --d: 0.4;
    }
    .mark--live .b4 {
      --d: 0.6;
    }

    .mark--live .check {
      stroke-dasharray: 22;
      animation: mark-verify 4s ease-in-out infinite;
    }

    .mark--live .octo {
      transform-origin: center;
      animation: mark-breathe 4s ease-in-out infinite;
    }
  }

  @keyframes mark-drift-a {
    50% {
      transform: translate(1.5px, -1.5px);
    }
  }

  @keyframes mark-drift-b {
    50% {
      transform: translate(-1.5px, 1.5px);
    }
  }

  @keyframes mark-blink {
    0%,
    60% {
      opacity: 1;
    }
    61%,
    100% {
      opacity: 0.2;
    }
  }

  @keyframes mark-ping {
    0%,
    72%,
    100% {
      transform: scale(1);
    }
    84% {
      transform: scale(1.16);
    }
  }

  @keyframes mark-flow {
    to {
      stroke-dashoffset: -16;
    }
  }

  @keyframes mark-sample {
    0%,
    100% {
      transform: scaleY(0.86);
    }
    50% {
      transform: scaleY(1.06);
    }
  }

  @keyframes mark-verify {
    0%,
    30% {
      stroke-dashoffset: 22;
    }
    55%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes mark-breathe {
    50% {
      transform: scale(1.04);
    }
  }
</style>
