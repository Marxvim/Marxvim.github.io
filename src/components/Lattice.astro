---
/**
 * Decorative WebGL background. Rendered as a custom element so the markup is
 * server-rendered and the three.js bundle loads as a deferred module.
 */
---

<div class="backdrop" aria-hidden="true">
  <marx-lattice></marx-lattice>
</div>
<div class="vignette" aria-hidden="true"></div>

<script>
  // three.js is ~130 kB gzipped for a purely decorative background, so it is
  // never on the critical path: the page paints first, the lattice hydrates
  // when the browser is idle, and data-saver clients skip it entirely.
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
    ?.saveData;

  if (!saveData) {
    const load = () => import('../scripts/lattice.ts');
    if ('requestIdleCallback' in window) requestIdleCallback(() => load(), { timeout: 2000 });
    else setTimeout(load, 200);
  }
</script>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  marx-lattice {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Fades the lattice into the page ground toward the edges. */
  .vignette {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      ellipse at 50% 45%,
      rgba(5, 6, 7, 0) 35%,
      rgba(5, 6, 7, 0.82) 100%
    );
  }
</style>
